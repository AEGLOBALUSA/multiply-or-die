# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create these in Stripe Dashboard first
STRIPE_PRICE_SHIPPING_STANDARD=price_...   # $9.95 standard shipping
STRIPE_PRICE_SHIPPING_PRIORITY=price_...   # $12.95 priority shipping
# Uncomment if using 3-line-item model (recommended):
# STRIPE_PRICE_BOOK=price_...              # $24.99 book

# ─── Resend ──────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@multiplyordie.com
RESEND_FROM_NAME="Multiply or Die"

# ─── FCG Legal — used in IRS donation receipts ───────────────
# ⚠️ Never expose to the client. Server-side only.
FCG_EIN=XX-XXXXXXX
FCG_LEGAL_NAME="Futures Church Global"
FCG_ADDRESS="[physical mailing address]"

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://multiplyordie.com

# Fair-market value of the book in cents — must match retail price.
# Confirmed by FCG accountant before launch. Used in IRS receipt.
NEXT_PUBLIC_BOOK_FMV_CENTS=2499

# ─── Drip cron ───────────────────────────────────────────────
# Shared secret between pg_cron and the process-drip Edge Function.
# Store in Supabase Vault, not plain settings.
CRON_SECRET=
